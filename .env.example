# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only; used by the Stripe webhook

# Public URL of the deployed app (used for email-confirmation and Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://jetlemon.com   # http://localhost:3000 for local dev

# Stripe (Developers → API keys; create a recurring Price for your plan)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_PLAN_PRICE=29            # Starter
STRIPE_PRO_PRICE_ID=price_...        # Pro ($49/mo) recurring price
NEXT_PUBLIC_PRO_PRICE=49

# Facebook / Instagram lead ads (Meta for Developers → your app → App settings → Basic)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=any-random-phrase-you-also-paste-into-the-webhook-setup

# Texting (Twilio Console → Account info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# AI assist (console.anthropic.com → API keys). Leave blank to turn AI features off.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Protects the hourly daily-brief job (Vercel → Project → Settings → Environment Variables; Vercel sends it automatically)
CRON_SECRET=

# JetLemon staff. Comma-separated emails that can open /admin (every business, plans, comps, numbers).
ADMIN_EMAILS=
