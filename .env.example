# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only; used by the Stripe webhook

# Public URL of the deployed app (used for email-confirmation and Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://crm.jetlemon.com   # http://localhost:3000 for local dev

# Stripe (Developers → API keys; create a recurring Price for your plan)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_PLAN_PRICE=29
